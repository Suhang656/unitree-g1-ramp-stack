# Installed as /etc/default/g1-ramp-stack
G1_PROJECT_DIR=/home/unitree/智能中控
# 必须在每台 G1 上分别填写；只能是连接 192.168.123.161 的内部网口。
G1_UNITREE_INTERFACE=CHANGE_ME
G1_CONTROL_IP=192.168.123.161
# 每台 G1 必须使用不同的小写ID。项目运动话题会自动加入该前缀。
G1_ROBOT_ID=CHANGE_ME
# 项目命令总线强制仅本机通信；保留0用于兼容本机官方ROS组件。
G1_COMMAND_ROS_DOMAIN_ID=0
UNITREE_SDK2_PYTHON_PATH=/home/unitree/unitree_sdk2_python
CYCLONEDDS_COMPAT_PREFIX=/home/unitree/cyclonedds-prefix
UNITREE_ROS2_SETUP=/home/unitree/unitree_ros2/cyclonedds_ws/install/setup.bash
G1_INTERNAL_MAP_PATH=/home/unitree/g1_internal_panorama_v2.pcd
# 完成官方 initialize 验证后改为 1；地图可能位于内部控制单元，NX 上未必可见。
G1_INTERNAL_MAP_VERIFIED=0
G1_FIXED_START_X=0.024735889031391838
G1_FIXED_START_Y=-0.08662520735348705
G1_FIXED_START_YAW=-0.3986063585212273
# 只学习本机成功开机定位后的微小修正，不改写上述人工基准点。
G1_BOOT_AUTO_ADJUST=1
G1_BOOT_SEARCH_RADIUS_M=0.50
G1_BOOT_POSITION_STEP_M=0.12
G1_BOOT_YAW_WINDOW_DEG=15
G1_BOOT_YAW_STEP_DEG=5
G1_BOOT_MAX_CANDIDATES=36
# 稳定但跳到错误地点/朝向的结果也必须拒绝。
G1_BOOT_ACCEPT_MAX_POSITION_ERROR_M=0.50
G1_BOOT_ACCEPT_MAX_YAW_ERROR_DEG=35
G1_LOCALIZATION_RETRY_SECONDS=2
G1_SLAM_RESET_WAIT_SECONDS=3
G1_WEB_PORT=8088
G1_VOICE_VOLUME=90
# 总运动授权。新部署默认拒绝除 stop 外的全部真实动作。
# 只有在机器人进入保护架、完成单机隔离检查后才临时改为1。
G1_ALLOW_REAL_MOTION=0
# 发生过返回跌倒事故；完成日志取证和保护架单点验证前保持0。
G1_ALLOW_RAMP_RETURN=0
# 阻尼、零力矩、调试及其它FSM切换默认全部禁用。
G1_ALLOW_MODE_COMMANDS=0
# 导览包含手臂示教动作，完成独立安全网关验证前不自动启动。
G1_ENABLE_TOUR=0
