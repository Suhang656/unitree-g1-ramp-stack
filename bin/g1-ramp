#!/usr/bin/env bash
set -Eeo pipefail

source /opt/ros/humble/setup.bash
PROJECT="${G1_PROJECT_DIR:-/home/unitree/智能中控}"
if [[ -r /etc/default/g1-ramp-stack ]]; then
  set -a
  source /etc/default/g1-ramp-stack
  set +a
fi
source "$PROJECT/scripts/load_g1_command_plane.sh"
set -u
REQUEST="$ROS2_ACTION_REQUEST_TOPIC"
RESULT="$ROS2_ACTION_RESULT_TOPIC"

publish() {
  local target="$1"
  local action="${2:-move}"
  local task="cli-${target}-$(date +%s)"
  ros2 topic pub --once "$REQUEST" std_msgs/msg/String \
    "{data: '{\"task_id\":\"$task\",\"robot_id\":\"$G1_ROBOT_ID\",\"source\":\"manual_cli\",\"action\":\"$action\",\"target\":\"$target\",\"speed\":0.4,\"confirmed\":true}'}"
}

case "${1:-help}" in
  status)
    for s in g1-voice-bridge g1-navigation-services g1-ramp-odom-cache g1-ramp-v3-bootstrap g1-local-assistant g1-global-stop-router g1-web-control g1-tour-executor; do
      printf '%-34s ' "$s"; systemctl is-active "$s.service" 2>/dev/null || true
    done
    echo "===== 运动桥（必须只有一个） ====="
    pgrep -af g1_motion_bridge.py || true
    echo "===== 本次开机定位许可 ====="
    /usr/bin/python3 - "$PROJECT/data/ramp_platform_v3/localization_ready.json" <<'PY'
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
if not p.exists():
    print("许可文件不存在")
    raise SystemExit(0)
d = json.loads(p.read_text(encoding="utf-8"))
b = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
print("success:", d.get("success"))
print("boot_id匹配:", d.get("boot_id") == b)
print("地图:", d.get("map_path", d.get("map")))
print("姿态:", d.get("pose"))
PY
    ;;
  odom)
    /usr/bin/python3 - "/run/g1-ramp/odom.json" <<'PY'
import json
import sys
import time
from pathlib import Path

path = Path(sys.argv[1])
if not path.exists():
    print("里程计缓存不存在；请检查 g1-ramp-odom-cache.service 和官方重定位。")
    raise SystemExit(1)

data = json.loads(path.read_text(encoding="utf-8"))
boot_id = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
if data.get("boot_id") != boot_id:
    print("里程计缓存不属于本次开机，拒绝使用。")
    raise SystemExit(1)

age = time.time() - float(data.get("updated_at_unix", 0.0))
if age < 0.0 or age > 3.0:
    print(f"里程计缓存已过期：{age:.2f}秒；请检查官方重定位。")
    raise SystemExit(1)

print("position:")
print(f"  x: {float(data['x'])}")
print(f"  y: {float(data['y'])}")
print("orientation:")
print(f"  yaw: {float(data['yaw'])}")
print(f"age_seconds: {age:.3f}")
PY
    ;;
  prepare) publish ramp_prepare ;;
  forward|straight-forward) publish continuous_forward ;;
  return|straight-return) publish ramp_return ;;
  turning-forward) publish turning_forward ;;
  turning-return) publish turning_return ;;
  stop) publish stop stop ;;
  result) ros2 topic echo "$RESULT" std_msgs/msg/String ;;
  logs) journalctl -u g1-local-assistant.service -f -n 0 -o cat ;;
  *) echo "用法：g1-ramp {status|odom|prepare|straight-forward|straight-return|turning-forward|turning-return|stop|result|logs}" ;;
esac

