#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG="/etc/default/g1-ramp-stack"
if [[ -r "$CONFIG" ]]; then
  set -a
  source "$CONFIG"
  set +a
fi

PROJECT="${G1_PROJECT_DIR:-/home/unitree/智能中控}"
DATA="$PROJECT/data/embodied_lab_panorama_v2"
READY="$PROJECT/data/ramp_platform_v3/localization_ready.json"
MAP="${G1_INTERNAL_MAP_PATH:-/home/unitree/g1_internal_panorama_v2.pcd}"
source "$PROJECT/scripts/require_g1_unitree_interface.sh"
INTERFACE="$G1_UNITREE_INTERFACE"
ROS_SETUP="${UNITREE_ROS2_SETUP:-/home/unitree/unitree_ros2/cyclonedds_ws/install/setup.bash}"

usage(){ echo "用法：g1-map-point {mark <name>|show <name>|list|check}"; }
valid_name(){ [[ "$1" =~ ^[a-z0-9][a-z0-9_]{0,63}$ ]] || { echo "名称只能使用小写字母、数字和下划线" >&2; exit 2; }; }
check_ready(){
  /usr/bin/python3 - "$READY" "$MAP" <<'PY'
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
expected = sys.argv[2]
if not p.exists():
    raise SystemExit("本次开机定位许可不存在")
d = json.loads(p.read_text(encoding="utf-8"))
boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
if d.get("success") is not True or d.get("boot_id") != boot:
    raise SystemExit("本次开机定位许可无效")
actual = str(d.get("map_path", d.get("map", "")))
if actual != expected:
    raise SystemExit(f"地图不匹配：{actual!r}")
print("定位许可有效，地图：", actual)
PY
}

mkdir -p "$DATA"
case "${1:-}" in
  mark)
    name="${2:-}"; [[ -n "$name" ]] || { usage; exit 2; }; valid_name "$name"; check_ready
    out="$DATA/$name.json"; [[ ! -e "$out" ]] || cp -a "$out" "$out.before_$(date +%Y%m%d_%H%M%S)"
    unset PYTHONPATH PYTHONHOME AMENT_PREFIX_PATH CMAKE_PREFIX_PATH COLCON_PREFIX_PATH CYCLONEDDS_HOME ROS_LOCALHOST_ONLY
    source /opt/ros/humble/setup.bash; source "$ROS_SETUP"
    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp ROS_DOMAIN_ID=0 ROS_LOCALHOST_ONLY=0 ROS2CLI_DISABLE_DAEMON=1
    export CYCLONEDDS_URI="<CycloneDDS><Domain Id=\"any\"><General><Interfaces><NetworkInterface name=\"$INTERFACE\"/></Interfaces></General></Domain></CycloneDDS>"
    echo "请让 G1 站直、静止，并保持目标朝向。"
    /usr/bin/python3 -u "$PROJECT/scripts/capture_turning_waypoint.py" "$out"
    /usr/bin/python3 - "$out" "$name" "$MAP" <<'PY'
import json, os, sys, time
from pathlib import Path
p = Path(sys.argv[1])
d = json.loads(p.read_text(encoding="utf-8"))
if d.get("success") is not True:
    raise SystemExit("采集结果无效")
d.update(
    point_name=sys.argv[2],
    map_version="portable_site",
    map_path=sys.argv[3],
    coordinate_frame="map",
    boot_id=Path("/proc/sys/kernel/random/boot_id").read_text().strip(),
    saved_at_unix=time.time(),
    source="/unitree/slam_relocation/odom",
)
t = p.with_suffix(".tmp")
t.write_text(json.dumps(d, ensure_ascii=False, indent=2), encoding="utf-8")
os.replace(t, p)
print(f"已保存 {d['point_name']}: x={d['x']:.6f} y={d['y']:.6f} yaw={d['yaw']:.6f}")
PY
    ;;
  show) name="${2:-}"; valid_name "$name"; /usr/bin/python3 -m json.tool "$DATA/$name.json" ;;
  list) find "$DATA" -maxdepth 1 -type f -name '*.json' -printf '%f\n' | sort ;;
  check) check_ready ;;
  *) usage; exit 2 ;;
esac
