[Unit]
Description=Unitree G1 reliable relocation odometry cache
Requires=g1-navigation-services.service
After=g1-navigation-services.service
Before=g1-local-assistant.service

[Service]
Type=simple
User=unitree
WorkingDirectory=/home/unitree/智能中控
EnvironmentFile=-/etc/default/g1-ramp-stack
RuntimeDirectory=g1-ramp
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/bash /home/unitree/智能中控/scripts/start_g1_ramp_odom_cache.sh
Restart=always
RestartSec=2
KillMode=control-group

[Install]
WantedBy=multi-user.target
