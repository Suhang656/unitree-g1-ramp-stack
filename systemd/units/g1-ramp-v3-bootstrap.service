[Unit]
Description=Unitree G1 fixed-start global localization bootstrap
Requires=g1-navigation-services.service g1-voice-bridge.service
After=network-online.target g1-navigation-services.service g1-voice-bridge.service

[Service]
Type=oneshot
User=unitree
WorkingDirectory=/home/unitree/智能中控
EnvironmentFile=-/etc/default/g1-ramp-stack
RuntimeDirectory=g1-ramp
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/bash /home/unitree/智能中控/scripts/start_g1_ramp_v3_bootstrap.sh
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=3
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
