# Smart Center: deterministic G1 motion commands do not require RAG.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=30m
DATABASE_PATH=data/smart_center.db
MAX_HISTORY_MESSAGES=40
UPLOAD_DIR=data/uploads
RAG_ENABLED=false
AGENT_MAX_STEPS=4
DEVICE_SIMULATION=false
DEVICE_REAL_ACTIONS_ENABLED=true
ROS2_ENABLED=true
ROS2_NODE_NAME=smart_center
ROS2_INPUT_TOPIC=/smart_center/input_text
ROS2_RESPONSE_TOPIC=/smart_center/response_text
ROS2_ACTION_REQUEST_TOPIC=/smart_center/robot_action_request
ROS2_ACTION_RESULT_TOPIC=/smart_center/robot_action_result
ROS2_ROBOT_STATUS_TOPIC=/smart_center/robot_status
ROS2_STATUS_TOPIC=/smart_center/status
ROS2_EMERGENCY_STOP_TOPIC=/smart_center/emergency_stop
STT_PROVIDER=disabled
TTS_PROVIDER=disabled

# Built-in G1 voice bridge
G1_VOICE_VOLUME=90
G1_VOICE_WAKE_WORD=小智小智
G1_VOICE_WAKE_ALIAS_1=小志小志
G1_VOICE_WAKE_ALIAS_2=小知小知
G1_VOICE_WAKE_REPLY=我在
G1_VOICE_WAKE_TIMEOUT=10
G1_VOICE_ACCEPT_INTERIM=true
